# frontend 환경변수 예시. 실제 값은 .env.local(로컬) 또는 배포 플랫폼 설정에만 넣는다.
# 값이 들어 있는 파일은 절대 commit 하지 않는다.
#
# 이름 규칙: NEXT_PUBLIC_ 이 붙은 값은 **브라우저 번들에 그대로 박힌다**.
# 백엔드 주소·토큰처럼 숨겨야 하는 값에는 절대 붙이지 않는다.

# ---------------------------------------------------------------------------
# 로컬 개발 — 브라우저가 로컬 백엔드를 직접 부른다
# ---------------------------------------------------------------------------

# 브라우저가 직접 부를 백엔드 주소. 정의하지 않으면 http://localhost:8110 을 쓴다.
# 아래 «사내 배포»처럼 Next.js 가 중계하게 하려면 이 값을 **빈 값으로 정의**해야 한다.
# 그래야 브라우저가 상대경로(/api/...)로 요청해 Next.js 서버를 거친다.
NEXT_PUBLIC_BACKEND_URL=http://localhost:8110

# ---------------------------------------------------------------------------
# 사내 배포 — Next.js 서버가 백엔드를 중계한다 (브라우저는 백엔드를 직접 부르지 않는다)
# ---------------------------------------------------------------------------

# 호스팅된 백엔드 주소 (예: https://... ). **서버 전용 — NEXT_PUBLIC_ 을 붙이지 마라.**
# 이 값이 있으면 /api/* 와 /health 요청을 Next.js 서버가 백엔드로 그대로 넘긴다.
# 비워 두면 아래 «읽기 전용 스냅샷» 동작(저장된 GET 응답만, 쓰기는 503)을 그대로 쓴다.
#
# 사내 배포에 필요한 조합:
#   BACKEND_URL=https://<백엔드 주소>
#   NEXT_PUBLIC_BACKEND_URL=          (빈 값으로 정의 — 브라우저가 상대경로를 쓰게)
#   NEXT_PUBLIC_DEMO_MODE=            (비움 — 읽기 전용이 아니다)
#   DEMO_USER / DEMO_PASSWORD / REQUIRE_AUTH=1
BACKEND_URL=

# 백엔드가 요구하는 인증 토큰. 있으면 Next.js 서버가 Authorization: Bearer <값> 을 붙인다.
# **서버 전용** — 브라우저로 내려가지 않는다. 백엔드에 토큰 검사가 없으면 비워 둔다.
API_TOKEN=

# ---------------------------------------------------------------------------
# 접근 게이트 (src/lib/demoAuth.ts)
# ---------------------------------------------------------------------------

# 공용 접근계정. 둘 다 있어야 게이트가 켜진다.
# 하나라도 비면 게이트를 걸지 않는다(로컬 개발). 값은 여기 적지 말고 배포 설정에만 넣는다.
#
# 개인 계정(data/private/users.json)을 쓰기 시작해도 이 공용 계정은 admin 으로 계속 통한다.
# 다만 **중계 배포에서는 백엔드 쪽에도 같은 두 값을 넣어야 한다** — 로그인 판정을 백엔드가
# 하기 때문이다. 넣지 않으면 개인 계정만 들어오고 공용 계정은 401 이 된다.
DEMO_USER=
DEMO_PASSWORD=

# 세션 쿠키 서명 키. 개인 계정·역할이 이 서명 위에 올라간다.
#   python -c "import secrets; print(secrets.token_hex(32))"
#
# 비워 두면 API_TOKEN 에서 파생하고(첫 로그인 때 경고 한 줄), API_TOKEN 도 없으면
# DEMO_USER:DEMO_PASSWORD 에서 파생한다. 마지막 경로는 «사람이 고른 비밀번호가 서명 키»가
# 되는 것이라 권할 만하지 않다 — **개인 계정을 쓰는 배포라면 이 값을 반드시 넣어라.**
# 값을 바꾸면 이미 로그인한 사람은 모두 다시 로그인한다.
SESSION_SECRET=

# 이 빌드가 실제 회사자료를 담고 있으면 1. 자격증명이 사라져도 열지 않고 잠근다(fail-closed).
# 사내 배포(BACKEND_URL 을 실제 백엔드로 둔 배포)는 1 로 켠다.
REQUIRE_AUTH=

# 백엔드 없이 저장된 스냅샷만으로 도는 읽기 전용 데모 배포이면 1.
# 화면이 「읽기 전용」임을 알리고 상대경로로 API 를 부른다. 사내 배포에서는 비워 둔다.
NEXT_PUBLIC_DEMO_MODE=
