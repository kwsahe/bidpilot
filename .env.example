APP_ENV=development

FRONTEND_URL=http://localhost:3110
BACKEND_URL=http://localhost:8110

# 공공데이터포털(data.go.kr) 나라장터 OpenAPI 서비스키.
# Encoding / Decoding 어느 쪽을 넣어도 동작한다 (인코딩된 키는 코드가 한 번 풀어 쓴다).
DATA_GO_KR_SERVICE_KEY=

# 기업마당(bizinfo.go.kr) 지원사업정보 OpenAPI 인증키. 없으면 합성 샘플(source=sample)로 표시된다.
BIZINFO_API_KEY=
# 위 인증키는 backend 에서만 쓴다. NEXT_PUBLIC_ 로 노출하지 말 것 (프론트 번들에 들어간다).
# 없으면 /api/support-programs 는 캐시 → 합성 샘플 순으로 동작하고 화면에 출처를 그대로 표시한다.

# Database (본선에서 사용 예정, 오늘은 미사용)
DATABASE_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# LLM (본선에서 사용 예정, 오늘은 미사용)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# LLM (Auditor 보조·제안서 생성·임베딩)
# LLM_PROVIDER — **완성**(제안서·사업계획서·Auditor·자격 보강) 공급자: openai | xai | claude_cli (25차).
#   임베딩은 공급자와 무관하게 늘 OPENAI_API_KEY 로 부른다(xAI 에는 임베딩이 없다).
# LLM_MODEL — openai 일 때만 쓰는 모델 이름. xai 로 바꾸면 XAI_MODEL 을 쓴다.
LLM_PROVIDER=openai
LLM_MODEL=gpt-4.1-mini
EMBEDDING_MODEL=text-embedding-3-small

# xAI(Grok) — LLM_PROVIDER=xai 일 때. OpenAI 호환 주소(https://api.x.ai/v1)로 같은 SDK 를 쓴다.
# ※ xAI 콘솔의 「데이터 공유(학습 사용)」는 켜지 마세요 — 회사자료가 학습에 쓰이고 되돌릴 수 없습니다.
#   (월 크레딧을 주는 대신 입력·출력이 모델 학습에 쓰인다 — 사업계획서에는 회사 실적이 들어간다)
XAI_API_KEY=
# 비우면 grok-4.7. gpt- · o · text- 로 시작하는 이름은 xAI 로 보내지 않는다.
XAI_MODEL=grok-4.7
# 추론 강도(low | high). 비우면 보내지 않는다 — grok-4.7 은 그때 high(추론 토큰도 과금).
XAI_REASONING_EFFORT=
# 완성 주소를 바꿀 때만. 비우면 공급자 기본 주소.
LLM_BASE_URL=
# 완성 호출 한 번의 제한 시간(초). 추론 모델은 60초로 모자랄 수 있다.
LLM_TIMEOUT_SECONDS=180

# Claude Code CLI(구독) — LLM_PROVIDER=claude_cli 일 때. 키가 필요 없다(이 PC 에 로그인된 claude 를 부른다).
# .env 를 고치지 않고 켜려면 scripts/start_demo_claude.bat (start_dev.ps1 -Ai -Provider claude_cli).
# ※ 담당자 본인 PC 에서만 — 회사 서버·Vercel 에는 CLI 로그인이 없고, 개인 구독으로 남을 위해 돌리지 않는다.
# ※ 개인 요금제(Pro·Max)면 claude.ai 설정 → 개인정보 → 「Claude 개선에 도움 주기」를 끈 뒤 쓴다.
#   도구 0 · 훅/CLAUDE.md 없음(--safe-mode) · 세션 기록 없음 · 빈 임시 폴더에서 부른다. ANTHROPIC_API_KEY 는 넘기지 않는다.
# 비우면 PATH 의 claude.
CLAUDE_CLI_PATH=
# 비우면 claude-opus-5-5. 별칭(opus · sonnet)도 된다.
CLAUDE_CLI_MODEL=claude-opus-5-5
# 추론 강도(low | medium | high | xhigh | max). 비우면 보내지 않는다(CLI 기본).
CLAUDE_CLI_EFFORT=

# --- 바깥을 실제로 부를지 (ISSUE-120) --------------------------------------
# **비워 두면 부르지 않는다.** 나라장터·기업마당 OpenAPI 를 실제로 호출하는 것은
# 이 두 값이 `1` 일 때뿐이다. 꺼져 있으면 저장된 캐시만 읽고, 화면과 `/health` 의
# `live_fetch_frozen` 이 그 사실을 그대로 말한다 (키를 비우는 편법과 다르다).
#
# 기본값이 예전에는 켜짐이었다. 그래서 환경변수를 세우지 않고 앱을 import 하기만 해도
# 바깥을 불렀고, 같은 사고가 세 번 났다 — 진단 스크립트 두 번과 떠 있던 개발 서버 한 번이
# git 이 추적하는 공고 캐시와 기업마당 캐시(1,620건 → 100건)를 말없이 덮었다.
# 실수로 부르는 쪽이 아니라 실수로 안 부르는 쪽이 안전하다.
#
# 켜는 자리는 셋뿐이다: `scripts/start_dev.ps1`(`-Frozen` 이 아닐 때) ·
# `scripts/collect_daily.py` · `scripts/refetch_bizinfo_cache.py`(자기 안에서 세우고 첫 줄에 알린다).
G2B_LIVE_FETCH=0
BIZINFO_LIVE_FETCH=0

# 캐시가 **크게 줄어드는 저장**을 허용할지 (ISSUE-121).
# 1 이면 새로 받은 건수가 기존의 절반 아래여도 그대로 덮어쓴다. 비워 두면 거부하고
# 사유를 남긴다 — 100건짜리 응답이 1,620건 캐시를 말없이 덮은 사고에서 나온 문이다.
CACHE_ALLOW_SHRINK=0

# --- OpenAI 임베딩도 같은 스위치 아래에 (ISSUE-129 · 15차) --------------------
# 위의 두 줄은 나라장터·기업마당만 막는다. OpenAI 는 14차까지 별개 문이었고, 키에
# 크레딧이 생긴 날 고정 모드 서버가 목록을 만들며 **임베딩 1,802건을 실제로 불렀다**.
# 기록에도 남지 않았고, 그 순간 점수가 바뀌어 목록(85)과 상세(74)가 갈렸다.
#
# 문이 둘인 이유: 벡터 캐시(`data/private/cache/embeddings/`)가 디스크에 남아 있으면
# 「부르지 않는다」만으로는 점수가 고정되지 않는다. 캐시를 지우는 것은 담당자 결정이므로
# 「읽지 않는다」를 따로 둔다.
#
# EMBEDDING_LIVE — 「바깥을 부르는가」. 0 이면 탐침도 embed() 도 아무것도 부르지 않고,
#                  OpenAI 클라이언트를 만들지도 않는다. 회사자료 색인·AI 검색도 함께 멈춘다.
# SEMANTIC_FIT   — 「점수에 쓰는가」. 0 이면 캐시 벡터가 있어도 사업영역 점수를 키워드
#                  규칙으로만 낸다. 기준 답안·큐시트 숫자가 그대로 유지된다.
#
# 비워 두면 둘 다 꺼짐이다. 켜는 자리는 `scripts/start_dev.ps1`(`-Frozen` 이 아닐 때)뿐이다.
# 켜고 시연하려면 기준 답안과 큐시트를 **다시 재야 한다** — 점수 축이 바뀐다.
EMBEDDING_LIVE=0
SEMANTIC_FIT=0

# --- 완성(제안서·사업계획서·Auditor)의 문 (ISSUE-130 · 16차) ----------------
# 담당자 방침: **순위·유사도는 규칙만, AI 는 제안서·사업계획서 초안과 제출 전 점검에만.**
# 위의 EMBEDDING_LIVE·SEMANTIC_FIT 을 끈 채 이것만 켜면 그 방침 그대로 돌아간다.
#
# LLM_LIVE — 0 이면 complete_structured 가 **클라이언트를 만들지 않고** 규칙 경로로 보낸다.
#            제안서·사업계획서·Auditor·자격 보강 넷이 모두 이 문 하나를 지난다.
#            켜는 자리는 `scripts/start_dev.ps1 -Ai`(= `scripts/start_demo_ai.bat`)뿐이다.
#
# LLM_CREDIT_CONFIRMED — 충전했으면 1. 호출 누계(llm_usage.jsonl)의 마지막 줄이 429 면
#            credit_ok() 가 거짓인데, 한 번 429 가 찍히면 **영원히** 닫힌다(다시 열려면
#            성공 기록이 필요한데 부르지 않으면 생기지 않는다). 이 값이 그 자물쇠를 연다.
#            **첫 호출이 성공하면 누계에 성공 줄이 남으므로 이후엔 없어도 된다.**
LLM_LIVE=0
# PLAN_WRITER_CLI — 1 이면 사업계획서 작성 페이지(/plan)의 「Claude로 쓰기」 · 「Codex로 쓰기」 단추만 이 PC 의 CLI 를 부른다(28차 · 29차).
# LLM_LIVE 와 다른 문이다 — 이것만 켜면 대시보드 6단계 제안서 · 제출 전 점검 · 자격 보강은 규칙만 쓴다.
# 보통은 여기 적지 않고 scripts\start_demo_claude.bat(= start_dev.ps1 -Frozen -PlanWriter)로 켠다.
PLAN_WRITER_CLI=0
# CODEX_CLI_PATH — Codex CLI(codex.exe) 경로(29차). 비우면 PATH 의 codex.exe. Windows 는 .exe 만 받는다.
#   ChatGPT 로 로그인(codex login)해 두면 구독으로 쓴다 — 자식 환경에서 OPENAI_* 는 빼고 부른다(API 키 과금 안 됨).
#   개인 요금제면 chatgpt.com 설정 → 데이터 제어 → 「모두를 위한 모델 개선」을 확인하세요(입력이 학습에 쓰일 수 있다).
CODEX_CLI_PATH=
# CODEX_CLI_MODEL — 비우면 CLI(로그인한 요금제)가 정한 기본 모델. 적으면 `-m` 으로 넘긴다.
CODEX_CLI_MODEL=
LLM_CREDIT_CONFIRMED=0

# 다회사 구조 — 호환 API(/api/company/...)가 위임하는 기본 조직 id (회사명이 아니라 영구 식별자)
DEFAULT_ORGANIZATION_ID=org-sample
# 공개 배포(읽기 전용 데모) 모드: 1이면 회사 생성·자료 업로드·승인·색인 API를 막고 근거 범위는 public_demo 만 허용
PUBLIC_DEMO_MODE=0

# 배포본(Next.js) 전용 — 서버에서만 읽는다. NEXT_PUBLIC_ 를 붙이지 말 것.
# DEMO_USER / DEMO_PASSWORD 가 둘 다 있어야 로그인 게이트가 켜진다.
# REQUIRE_AUTH=1 이면 **실제 회사자료가 실린 빌드**로 보고, 자격증명이 없을 때 화면을 열지 않고 잠근다.
# 사내 배포(스냅샷을 --include-company 로 뜬 경우)에는 반드시 1로 둔다.
REQUIRE_AUTH=0

# 로그인 세션 쿠키의 서명 키. Next.js 서버만 읽는다(백엔드는 쓰지 않는다).
# 쿠키에 담긴 「누구·어떤 역할·언제까지」를 사용자가 고쳐 쓰지 못하게 HMAC 으로 묶는 용도다.
# 만들기: python -c "import secrets; print(secrets.token_hex(32))"
# 비워 두면 첫 로그인 때 경고를 한 줄 남기고 API_TOKEN 에서 키를 파생한다 — 그러면 토큰을
# 바꿀 때 로그인 세션까지 함께 끊긴다. 이 값을 바꿔도 이미 로그인한 사람은 모두 다시 로그인한다.
# 값은 여기 적지 말고 배포 설정(Vercel 환경변수)에만 넣는다.
#
# **이 파일은 백엔드(pydantic Settings)가 읽는다. Next.js 는 읽지 않는다.**
# 세션 서명은 Next.js 서버가 하므로 실제로 필요한 자리는 `frontend/.env.example` 쪽이다.
# 여기 둔 이유는 두 프로세스를 한 기계에서 띄우는 사내 배포에서 같은 값을 쓰기 때문이다.
SESSION_SECRET=

# --- 백엔드 호스팅 (사내 배포) ---------------------------------------------
# 데이터 저장 위치. 컨테이너에서는 영구 볼륨 경로를 준다 (예: /data).
# 주의: 이 값은 **실제 환경변수**로만 읽는다 (.env 파일은 보지 않는다 — app/core/paths.py).
#       컨테이너·PaaS 는 환경변수를 직접 주므로 정상이지만, 로컬에서 .env 에만 적으면 적용되지 않는다.
#       비워 두면 저장소의 data/ 를 쓴다. 테스트는 항상 저장소 data/ 를 읽으므로
#       pytest 를 돌릴 때는 DATA_DIR 를 비워 둘 것.
DATA_DIR=

# 백엔드 API 토큰. 설정하면 /health 와 CORS preflight 를 뺀 모든 요청에
# Authorization: Bearer <값> 또는 X-API-Token: <값> 을 요구한다.
# 비어 있으면 아무것도 막지 않는다(로컬 개발 그대로).
# 브라우저는 백엔드를 직접 부르지 않는다 — Next.js 서버가 이 토큰을 붙여 중계한다.
API_TOKEN=

# CORS 허용 오리진. 쉼표로 구분. 비우면 FRONTEND_URL 만 허용한다.
# 값을 지정하면 개발용 localhost 와일드카드는 꺼진다.
ALLOWED_ORIGINS=

# 평일 아침 슬랙 브리핑(2.6.0 · scripts/slack_brief_now.sh · cron 평일 07:40 · 09:40 · 11:40) — 슬랙 「Incoming Webhook」 주소(https://hooks.slack.com/…).
# 비밀 값 — 회사 서버 .env(600)에만 적는다. 노트북 .env 에도 적으면 두 곳에서 두 번 간다. 비우면 보내지 않는다.
SLACK_WEBHOOK_URL=
